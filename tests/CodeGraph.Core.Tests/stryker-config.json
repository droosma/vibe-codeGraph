{
  "stryker-config": {
    "project": "CodeGraph.Core.csproj",
    "solution": "../../CodeGraph.sln",
    "reporters": ["progress", "html", "json"],
    "verbosity": "info",
    "thresholds": {
      "high": 100,
      "low": 90,
      "break": 80
    },
    "ignore-methods": ["ConfigureAwait"],
    "mutate": [
      "!**/obj/**",
      "!**/bin/**"
    ]
  }
}
